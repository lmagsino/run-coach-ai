# Environment / secrets
.env
.env.*
!.env.example

# Go
/bin/
/tmp/
*.exe
*.test
*.out
vendor/

# Build artifacts
/dist/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local Postgres data (if run in-repo)
/pgdata/

