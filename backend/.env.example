# Copy to .env and fill in real values. .env is gitignored; this file is not.

# --- HTTP server ---
PORT=8080

# --- Postgres (optional until chats are persisted in Phase 7) ---
# Leave unset to run without a database; /healthz then reports db: off.
# Local dev default once needed (homebrew Postgres, passwordless socket trust):
#DATABASE_URL=postgres://postgres@localhost:5432/runcoach_dev?sslmode=disable

# --- Garmin MCP (upstream Taxuspt/garmin_mcp, the only data source) ---
# Unset = no source; every live request answers 503 saying so. Set once the
# local image is built and authenticated (see deploy/garmin-mcp/README.md):
#   cd deploy/garmin-mcp
#   docker compose build
#   docker compose --profile auth run --rm garmin-mcp-auth   # email/password + MFA, once
# The spawned server receives an allowlisted environment only (PATH, HOME,
# GARMINTOKENS, DOCKER_*): it can never sign in to Garmin itself.
#GARMIN_MCP_COMMAND=docker run -i --rm -v run-coach-ai-garmin-tokens:/root/.garminconnect run-coach-ai/garmin-mcp:latest

# Garmin Connect login, read ONLY by the one-off `garmin-mcp-auth` step above
# (compose forwards it from this file). The server never reads these.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password
# Set to true only for Garmin Connect China (garmin.cn).
#GARMIN_IS_CN=false

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Claude model for the coach (ADR 0006). claude-sonnet-5-5 is the cheaper fallback.
ANTHROPIC_MODEL=claude-opus-5-5
# Effort sent with every request: low | medium | high. Thinking cannot be
# switched off on Opus 5.5, so this is the one dial on reasoning cost.
ANTHROPIC_EFFORT=medium

# --- Frontend / dev ---
# Browser origin allowed by CORS. The Vue dev server (Vite) runs here; the API
# is on :8080, so every browser request is cross-origin. Empty disables CORS.
ALLOWED_ORIGIN=http://localhost:5173

# Mock mode: serve canned answers for the five example questions instead of
# calling Claude or Garmin. Needs no credentials and no database, so the
# frontend can be built and demoed with nothing set up. While it is on,
# nothing you see comes from real data, and the UI says so.
# Accepts 1/true/yes/on; anything else (including unset) is off.
#RUNCOACH_MOCK=1
