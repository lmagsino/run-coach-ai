# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Values here override the shell's environment (so a key exported for another
# tool cannot leak in); on a host without .env the environment is used as is.

# --- HTTP server ---
PORT=8787

# --- Postgres (optional until chats are persisted in Phase 7) ---
# Leave unset to run without a database; /healthz then reports db: off.
# Local dev default once needed (homebrew Postgres, passwordless socket trust):
#DATABASE_URL=postgres://postgres@localhost:5432/runcoach_dev?sslmode=disable

# --- Garmin MCP (upstream Taxuspt/garmin_mcp, the only data source) ---
# The command that starts the server for each reply. Default: `garmin-mcp` on
# PATH, which the hosted image has. Local dev runs the Docker image instead:
#   cd deploy/garmin-mcp && docker compose build garmin-mcp
#GARMIN_MCP_COMMAND=docker run -i --rm -e GARMINTOKENS run-coach-ai/garmin-mcp:latest
# The runner's token bundle (pasted on the Connection page, stored encrypted)
# is handed to the child as GARMINTOKENS. The child gets an allowlisted
# environment only (PATH, HOME, GARMINTOKENS, DOCKER_*): it can never sign in
# to Garmin itself. To use a named volume authenticated by garmin-mcp-auth
# instead of a pasted bundle (no database needed):
#GARMIN_MCP_COMMAND=docker run -i --rm -v run-coach-ai-garmin-tokens:/root/.garminconnect run-coach-ai/garmin-mcp:latest

# --- Garmin token bundle import ---
# On start the server imports the bundle deploy/garmin-mcp/auth.sh leaves at
# backend/.garmin_bundle.b64 (or the inline value below, for a host), probes it
# and stores it encrypted. The Connection page's paste box is the fallback.
#RUNCOACH_GARMIN_BUNDLE_FILE=.garmin_bundle.b64
#RUNCOACH_GARMIN_BUNDLE=

# --- Owner login and token storage (Phase 7) ---
# bcrypt hash of the owner's password: echo -n 'pw' | go run ./cmd/hash-password
# Unset = nobody can log in (mock mode needs no login). Keep the single quotes:
# the hash contains $ and both godotenv and compose would expand it otherwise.
#RUNCOACH_OWNER_PASSWORD_HASH='$2a$10$...'
# 32 random bytes, base64, sealing the stored Garmin bundle: go run ./cmd/token-key
#RUNCOACH_TOKEN_KEY=

# Garmin Connect login, read ONLY by the one-off `garmin-mcp-auth` step above
# (compose forwards it from this file). The server never reads these.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password
# Set to true only for Garmin Connect China (garmin.cn).
#GARMIN_IS_CN=false

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Claude model for the coach (ADR 0006). claude-sonnet-5-5 is the cheaper fallback.
ANTHROPIC_MODEL=claude-opus-5-5
# Effort sent with every request: low | medium | high. Thinking cannot be
# switched off on Opus 5.5, so this is the one dial on reasoning cost.
ANTHROPIC_EFFORT=medium

# --- Frontend / dev ---
# The UI is served by this binary (one origin) and the Vite dev server proxies
# /api to :8787, so CORS is off by default. Set an origin only if a browser
# must call the API from somewhere else.
#ALLOWED_ORIGIN=

# Mock mode: serve canned answers for the five example questions instead of
# calling Claude or Garmin. Needs no credentials and no database, so the
# frontend can be built and demoed with nothing set up. While it is on,
# nothing you see comes from real data, and the UI says so.
# Accepts 1/true/yes/on; anything else (including unset) is off.
#RUNCOACH_MOCK=1
