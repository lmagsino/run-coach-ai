# Copy to .env and fill in real values. .env is gitignored; this file is not.

# --- HTTP server ---
PORT=8080

# --- Postgres ---
# Local dev default (asdf/homebrew Postgres, passwordless socket trust):
DATABASE_URL=postgres://postgres@localhost:5432/runcoach_dev?sslmode=disable

# --- Strava API app (https://www.strava.com/settings/api) ---
STRAVA_CLIENT_ID=your_numeric_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REDIRECT_URI=http://localhost:8080/auth/strava/callback

# --- Strava MCP (self-hosted server the backend connects to as an MCP client) ---
# Command that launches the strava-mcp server. Default runs it from source;
# for a faster start, `go build -o bin/strava-mcp ./cmd/strava-mcp` and set this
# to the built binary path.
STRAVA_MCP_COMMAND=go run ./cmd/strava-mcp

# --- Garmin MCP (self-hosted Taxuspt/garmin_mcp container) ---
# Unset = Garmin is disabled and Strava is the only tool source. Uncomment once
# the image is built and authenticated (see deploy/garmin-mcp/docker-compose.yml):
#   cd deploy/garmin-mcp
#   docker compose build
#   docker compose --profile auth run --rm garmin-mcp-auth   # email/password + MFA
# `-e VAR` with no value forwards the variable from this file into the container.
#GARMIN_MCP_COMMAND=docker run -i --rm -e GARMIN_EMAIL -e GARMIN_PASSWORD -e GARMIN_IS_CN -e GARMIN_ENABLED_TOOLS -v run-coach-ai-garmin-tokens:/root/.garminconnect run-coach-ai/garmin-mcp:latest

# Garmin Connect login. Only needed for the one-time `garmin-mcp-auth` step;
# afterwards the container reuses OAuth tokens cached in the mounted volume
# (~6 months). MFA is entered interactively at that prompt, not stored here.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your_garmin_password
# Set to true only for Garmin Connect China (garmin.cn).
#GARMIN_IS_CN=false

# --- Anthropic (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# Claude model for the agent loop (spec chose Sonnet).
ANTHROPIC_MODEL=claude-sonnet-5

# --- Frontend / dev ---
# Browser origin allowed by CORS. The Vue dev server (Vite) runs here; the API
# is on :8080, so every browser request is cross-origin. Empty disables CORS.
ALLOWED_ORIGIN=http://localhost:5173

# Mock mode: serve canned answers for the feature spec's five example questions
# instead of calling Claude or any MCP source. Bypasses the Strava-token and
# Anthropic-key requirements, so the frontend can be built and demoed with no
# credentials at all (Phase 4). Turn OFF for Phase 5 live verification — while
# it is on, nothing you see comes from real data.
# Accepts 1/true/yes/on; anything else (including unset) is off.
# Also skips the Postgres connection, so DATABASE_URL above is unused while it is
# on and no database needs to be running.
#RUNCOACH_MOCK=1
